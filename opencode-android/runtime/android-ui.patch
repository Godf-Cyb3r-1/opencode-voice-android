@@ -270,3 +270,43 @@ test("answers /btw in the side panel without admitting a prompt", async ({ page
   await expect(panel.getByText("exponential backoff", { exact: false })).toBeVisible()
   expect(ownerWarnings).toEqual([])
 })
+
+
+test("mobile side questions reopen, cancel independently, and never submit a main prompt", async ({ page }) => {
+  await page.setViewportSize({ width: 390, height: 844 })
+
+  const prompts: unknown[] = []
+  const held = Promise.withResolvers<void>()
+
+  const { editor } = await openSession(page, {
+    name: "MobileBtw",
+    onPrompt: (input) => prompts.push(input),
+    generate: async (input) => {
+      if (input.prompt.includes("slow question")) await held.promise
+
+      return { text: input.prompt.includes("slow question") ? "Cancelled answer" : "Mobile answer" }
+    },
+  })
+
+  const navigation = page.getByRole("tablist", { name: "Session view", exact: true })
+  const panel = page.locator('[data-slot="session-btw-panel"]')
+
+  await editor.fill("/btw first question")
+  await editor.press("Enter")
+  await expect(panel.getByText("Mobile answer", { exact: true })).toBeVisible()
+  await navigation.getByRole("tab", { name: "Session", exact: true }).click()
+  await editor.fill("/btw slow question")
+  await editor.press("Enter")
+  await panel.getByRole("button", { name: "Cancel side question", exact: true }).click()
+  held.resolve()
+  await expect(panel.getByRole("button", { name: "Retry", exact: true })).toBeVisible()
+  await expect(panel.getByText("Cancelled answer", { exact: true })).toHaveCount(0)
+  await panel.getByRole("combobox", { name: "Side questions", exact: true }).selectOption({ label: "first question" })
+  await expect(panel.getByText("Mobile answer", { exact: true })).toBeVisible()
+  await page.reload()
+  await navigation.getByRole("tab", { name: "More...", exact: true }).click()
+  await page.getByRole("dialog", { name: "More options", exact: true }).getByRole("button", { name: "Side questions", exact: true }).click()
+  await panel.getByRole("combobox", { name: "Side questions", exact: true }).selectOption({ label: "first question" })
+  await expect(panel.getByText("Mobile answer", { exact: true })).toBeVisible()
+  expect(prompts).toEqual([])
+})
